{
  "name": "n8n-nodes-zapzap",
  "version": "0.1.0",
  "description": "Nodes n8n para a ZapZap API — envie mensagens de WhatsApp e gerencie instâncias (n8n community node). WhatsApp automation for n8n.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "whatsapp",
    "zapzap",
    "zapzapapi",
    "messaging",
    "chatbot",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://zapzapapi.com",
  "author": {
    "name": "Rodrigo Damazio",
    "email": "contato@zapzapapi.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zapzapapi/n8n-nodes-zapzap.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ZapZapApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZapZap/ZapZap.node.js",
      "dist/nodes/ZapZapTrigger/ZapZapTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.60.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  }
}
